[0.013, "o", "\u001b[1;32m# Deploy n8n to an existing server via Stacker\u001b[0m\r\n"]
[1.007, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m# Step 1 — generate .env secrets\u001b[0m\r\n"]
[1.008, "o", "\u001b[2;37m$ cp -f .env.example .env\u001b[0m\r\n"]
[0.005, "o", "\u001b[2;37m$ ./scripts/generate-secrets.sh\u001b[0m\r\n"]
[0.022, "o", "  Generated DB_PASSWORD\r\n"]
[0.014, "o", "  Generated N8N_PASSWORD\r\nSecrets ready.\r\n"]
[1.007, "o", "\r\n\u001b[1;33m# Step 2 — server target is already in stacker.yml\u001b[0m\r\n"]
[1.009, "o", "\u001b[2;37m$ grep -A6 ^deploy: stacker.yml\u001b[0m\r\n"]
[0.003, "o", "deploy:\r\n  target: server\r\n  server:\r\n    host: 46.224.127.228\r\n    user: root\r\n    ssh_key: /Users/vasilipascal/work/stacker-project-examples/stacker-project-test\r\n\r\n"]
[1.009, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m# Step 3 — deploy: pull image, start containers on the remote\u001b[0m\r\n"]
[1.009, "o", "\u001b[2;37m$ stacker deploy --target server --force-rebuild\u001b[0m\r\n"]

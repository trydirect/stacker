[0.007, "o", "\u001b[1;32m# Deploy Gotify to an existing server via Stacker\u001b[0m\r\n"]
[1.007, "o", "\r\n\u001b[1;33m# Step 1 — generate .env secrets\u001b[0m\r\n"]
[1.007, "o", "\u001b[2;37m$ cp -f .env.example .env\u001b[0m\r\n"]
[0.005, "o", "\u001b[2;37m$ ./scripts/generate-secrets.sh\u001b[0m\r\n"]
[0.024, "o", "  Generated GOTIFY_DEFAULTUSER_PASS\r\nSecrets ready.\r\n"]
[1.005, "o", "\r\n"]
[0.000, "o", "\u001b[1;33m# Step 2 — server target is already in stacker.yml\u001b[0m\r\n"]
[1.009, "o", "\u001b[2;37m$ grep -A6 ^deploy: stacker.yml\u001b[0m\r\n"]
[0.006, "o", "deploy:\r\n  target: server\r\n  server:\r\n    host: 46.224.127.228\r\n    user: root\r\n    ssh_key: /Users/vasilipascal/work/stacker-project-examples/stacker-project-test\r\n    port: 22\r\n"]
[1.007, "o", "\r\n"]
[0.001, "o", "\u001b[1;33m# Step 3 — deploy: pull image, start containers on the remote\u001b[0m\r\n"]
[1.008, "o", "\u001b[2;37m$ stacker deploy --target server --force-rebuild\u001b[0m\r\n"]
[0.084, "o", "\u001b[36m⠋\u001b[0m Deploy: starting...                                                           "]
